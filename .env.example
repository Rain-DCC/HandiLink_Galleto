# GEMINI_API_KEY: Required for Gemini AI API calls (Pattern Vision & Cebuano Speech AI).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing JWT session tokens (defaults to secure ephemeral secret in dev if omitted).
JWT_SECRET="CHANGE_ME_TO_A_STRONG_64_CHAR_RANDOM_SECRET"

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: Required for Google OAuth 2.0 Sign-In / Sign-Up.
# Configure redirect URI in Google Cloud Console as: ${APP_URL}/api/gateway/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
